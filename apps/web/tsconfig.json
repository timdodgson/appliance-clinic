{
  // Type-checks the browser scripts as plain JavaScript (JSDoc where a DOM type needs narrowing). admin.js and sw.js
  // are linted but not type-checked: the admin is ~7,800 lines of string-built DOM code written without types, and
  // the service worker needs the WebWorker lib, which conflicts with DOM in one program.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": [],
    "skipLibCheck": true,
    "noImplicitThis": true,
    "strictBindCallApply": true
  },
  "include": ["public/**/*.js", "types/**/*.d.ts"],
  "exclude": ["public/admin.js", "public/sw.js", "node_modules", "dist"]
}
