        "arn:aws:s3:::spares4repairs-*",
        "arn:aws:s3:::cdk-hnb659fds-*",
        "arn:aws:s3:::cdk-acclinic-*",
        "arn:aws:secretsmanager:*:800960611664:secret:spares4repairs/*",
        "arn:aws:ecr:*:800960611664:repository/spares4repairs-diag-orchestrator",
        "arn:aws:ecr:*:800960611664:repository/spares4repairs-error-code-mcp",
        "arn:aws:ecr:*:800960611664:repository/spares4repairs-generator",
