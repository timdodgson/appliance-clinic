{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AccountReads",
      "Effect": "Allow",
      "Action": [
        "sts:GetCallerIdentity",
        "ecr:GetAuthorizationToken",
        "cloudformation:ValidateTemplate",
        "cloudformation:ListStacks",
        "cloudformation:DescribeStacks",
        "cloudformation:GetTemplateSummary",
        "lambda:ListFunctions",
        "lambda:GetAccountSettings",
        "dynamodb:ListTables",
        "dynamodb:ListBackups",
        "s3:ListAllMyBuckets",
        "logs:DescribeLogGroups",
        "secretsmanager:ListSecrets",
        "events:ListRules",
        "ssm:DescribeParameters",
        "iam:ListRoles",
        "iam:ListPolicies",
        "cognito-idp:ListUserPools",
        "tag:GetResources"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SandboxLambda",
      "Effect": "Allow",
      "Action": "lambda:*",
      "Resource": [
        "arn:aws:lambda:eu-west-1:800960611664:function:*-sbx",
        "arn:aws:lambda:eu-west-1:800960611664:function:*-sbx:*"
      ]
    },
    {
      "Sid": "SandboxLogs",
      "Effect": "Allow",
      "Action": "logs:*",
      "Resource": [
        "arn:aws:logs:eu-west-1:800960611664:log-group:/aws/lambda/*-sbx",
        "arn:aws:logs:eu-west-1:800960611664:log-group:/aws/lambda/*-sbx:*"
      ]
    },
    {
      "Sid": "SandboxData",
      "Effect": "Allow",
      "Action": [
        "dynamodb:*",
        "s3:*",
        "ecr:*",
        "secretsmanager:*",
        "events:*",
        "ssm:*"
      ],
      "Resource": [
        "arn:aws:dynamodb:eu-west-1:800960611664:table/whichpart-*-sbx*",
        "arn:aws:s3:::*-sbx-800960611664",
        "arn:aws:s3:::*-sbx-800960611664/*",
        "arn:aws:s3:::cdk-acsbx-assets-800960611664-eu-west-1",
        "arn:aws:s3:::cdk-acsbx-assets-800960611664-eu-west-1/*",
        "arn:aws:ecr:eu-west-1:800960611664:repository/*-sbx",
        "arn:aws:ecr:eu-west-1:800960611664:repository/cdk-acsbx-*",
        "arn:aws:secretsmanager:eu-west-1:800960611664:secret:applianceclinic-sbx/*",
        "arn:aws:events:eu-west-1:800960611664:rule/*-sbx",
        "arn:aws:ssm:eu-west-1:800960611664:parameter/cdk-bootstrap/acsbx/*"
      ]
    },
    {
      "Sid": "SandboxStacks",
      "Effect": "Allow",
      "Action": "cloudformation:*",
      "Resource": [
        "arn:aws:cloudformation:eu-west-1:800960611664:stack/*-sbx/*",
        "arn:aws:cloudformation:eu-west-1:800960611664:stack/ApplianceClinicSandboxToolkit/*"
      ]
    },
    {
      "Sid": "SandboxRolesWithBoundary",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:PutRolePermissionsBoundary"
      ],
      "Resource": [
        "arn:aws:iam::800960611664:role/*-sbx",
        "arn:aws:iam::800960611664:role/SparesSite-sbx-*"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::800960611664:policy/ac-cfn-execution-sbx"
        }
      }
    },
    {
      "Sid": "SandboxRolesAttachBasicOnly",
      "Effect": "Allow",
      "Action": [
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy"
      ],
      "Resource": [
        "arn:aws:iam::800960611664:role/*-sbx",
        "arn:aws:iam::800960611664:role/SparesSite-sbx-*"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::800960611664:policy/ac-cfn-execution-sbx",
          "iam:PolicyARN": "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
        }
      }
    },
    {
      "Sid": "SandboxRolesOther",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:ListRoleTags",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:UpdateRole",
        "iam:UpdateRoleDescription",
        "iam:UpdateAssumeRolePolicy",
        "iam:DeleteRole"
      ],
      "Resource": [
        "arn:aws:iam::800960611664:role/*-sbx",
        "arn:aws:iam::800960611664:role/SparesSite-sbx-*"
      ]
    },
    {
      "Sid": "PassSandboxRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::800960611664:role/*-sbx",
        "arn:aws:iam::800960611664:role/SparesSite-sbx-*",
        "arn:aws:iam::800960611664:role/cdk-acsbx-cfn-exec-role-800960611664-eu-west-1"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "lambda.amazonaws.com",
            "cloudformation.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "StandInApiCreate",
      "Effect": "Allow",
      "Action": "apigateway:POST",
      "Resource": "arn:aws:apigateway:eu-west-1::/apis",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/ac:sandbox": "phase-4"
        }
      }
    },
    {
      "Sid": "StandInApiList",
      "Effect": "Allow",
      "Action": "apigateway:GET",
      "Resource": "arn:aws:apigateway:eu-west-1::/apis"
    },
    {
      "Sid": "StandInApi",
      "Effect": "Allow",
      "Action": "apigateway:*",
      "Resource": "arn:aws:apigateway:eu-west-1::/apis/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/ac:sandbox": "phase-4"
        }
      }
    },
    {
      "Sid": "StandInPoolCreate",
      "Effect": "Allow",
      "Action": [
        "cognito-idp:CreateUserPool",
        "cognito-idp:TagResource"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/ac:sandbox": "phase-4"
        }
      }
    },
    {
      "Sid": "StandInPool",
      "Effect": "Allow",
      "Action": "cognito-idp:*",
      "Resource": "arn:aws:cognito-idp:eu-west-1:800960611664:userpool/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/ac:sandbox": "phase-4"
        }
      }
    },
    {
      "Sid": "ToolkitRolesViaCloudFormation",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:GetRole",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:GetRolePolicy",
        "iam:UpdateAssumeRolePolicy"
      ],
      "Resource": [
        "arn:aws:iam::800960611664:role/cdk-acsbx-*"
      ],
      "Condition": {
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": [
            "cloudformation.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "ToolkitRolesAttachReviewedOnly",
      "Effect": "Allow",
      "Action": [
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy"
      ],
      "Resource": [
        "arn:aws:iam::800960611664:role/cdk-acsbx-*"
      ],
      "Condition": {
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": [
            "cloudformation.amazonaws.com"
          ]
        },
        "StringEquals": {
          "iam:PolicyARN": [
            "arn:aws:iam::aws:policy/ReadOnlyAccess",
            "arn:aws:iam::aws:policy/AWSCloudFormationReadOnlyAccess",
            "arn:aws:iam::800960611664:policy/ac-cfn-execution-sbx",
            "arn:aws:iam::800960611664:policy/ac-deny-production-sbx"
          ]
        }
      }
    },
    {
      "Sid": "AssumeToolkitRoles",
      "Effect": "Allow",
      "Action": "sts:AssumeRole",
      "Resource": [
        "arn:aws:iam::800960611664:role/cdk-acsbx-*"
      ]
    },
    {
      "Sid": "ViewBudget",
      "Effect": "Allow",
      "Action": "budgets:ViewBudget",
      "Resource": "arn:aws:budgets::800960611664:budget/ac-budget-sbx"
    }
  ]
}
