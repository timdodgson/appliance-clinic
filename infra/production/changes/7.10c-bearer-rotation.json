{
  "id": "7.10c-bearer-rotation",
  "description": "Rotate the service bearer tokens onto the AC secret namespace: every consumer reads them through {{resolve:secretsmanager:applianceclinic/production/<name>:SecretString:token}} dynamic references (orchestrator ORCH_BEARER_TOKEN and whichpart-api ORCHESTRATOR_TOKEN from orchestrator-bearer; MCP_BEARER_TOKEN on the MCP, the orchestrator and whichpart-api from mcp-bearer). The values are new (generated by Secrets Manager in 7.10a); no value passes through the operator, git, a template or a log. The old values stop working. The NoEcho token parameters disappear from the template. Environment only.",
  "classification": "SAFE AC CHANGE",
  "stack": "AcRuntimeStack",
  "kind": "UPDATE",
  "expectedChanges": [
    {
      "action": "Modify",
      "logicalId": "whichpartapi",
      "type": "AWS::Lambda::Function",
      "physicalId": "whichpart-api",
      "replacement": "False",
      "details": [
        "Properties.Environment"
      ]
    },
    {
      "action": "Modify",
      "logicalId": "spares4repairsdiagorchestrator",
      "type": "AWS::Lambda::Function",
      "physicalId": "spares4repairs-diag-orchestrator",
      "replacement": "False",
      "details": [
        "Properties.Environment"
      ]
    },
    {
      "action": "Modify",
      "logicalId": "spares4repairserrorcodemcp",
      "type": "AWS::Lambda::Function",
      "physicalId": "spares4repairs-error-code-mcp",
      "replacement": "False",
      "details": [
        "Properties.Environment"
      ]
    }
  ],
  "grant": [
    {
      "Action": [
        "lambda:UpdateFunctionConfiguration"
      ],
      "Resource": [
        "arn:aws:lambda:eu-west-1:800960611664:function:whichpart-api",
        "arn:aws:lambda:eu-west-1:800960611664:function:spares4repairs-diag-orchestrator",
        "arn:aws:lambda:eu-west-1:800960611664:function:spares4repairs-error-code-mcp"
      ]
    },
    {
      "Action": [
        "iam:PassRole"
      ],
      "Resource": [
        "arn:aws:iam::800960611664:role/whichpart-api-role",
        "arn:aws:iam::800960611664:role/diag-orchestrator-role",
        "arn:aws:iam::800960611664:role/error-code-mcp-role"
      ]
    }
  ],
  "grantNotes": "Environment updates of the three AC functions and PassRole on their own roles. The dynamic references are resolved with the read-only base's ResolveAcBearerReferences statement (the two bearer secrets only).",
  "writes": {
    "types": [
      "AWS::Lambda::Function"
    ],
    "expected": [
      "lambda:UpdateFunctionConfiguration"
    ],
    "forbidden": [
      "lambda:UpdateFunctionCode",
      "lambda:AddPermission",
      "lambda:RemovePermission",
      "lambda:UpdateFunctionUrlConfig",
      "secretsmanager:PutSecretValue",
      "secretsmanager:UpdateSecret"
    ],
    "resources": [
      "whichpart-api",
      "spares4repairs-diag-orchestrator",
      "spares4repairs-error-code-mcp"
    ],
    "forbiddenResources": [
      "spares4repairs-part-finder",
      "SparesSite-dev",
      "eu-west-1_mUWucohuX"
    ]
  }
}
