      "physicalId": "spares4repairs-part-finder",
      "replacement": "False",
      "details": [
        "Properties.Code",
        "Properties.Environment"
      ]
    },
    {
      "action": "Modify",
      "logicalId": "whichpartapi",
      "type": "AWS::Lambda::Function",
      "physicalId": "whichpart-api",
      "replacement": "False",
      "details": [
        "Properties.Code",
        "Properties.Environment"
      ]
    }
  ],
  "grant": [
