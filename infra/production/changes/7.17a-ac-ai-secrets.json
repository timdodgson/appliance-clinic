{
  "id": "7.17a-ac-ai-secrets",
  "description": "D (owner-approved): create applianceclinic/production/ai-config, openai and jev in AcDataStack, each with a generated placeholder. infra/production/steps/d-copy-secrets.sh then gives them the existing values server side; no consumer reads them until 7.17c. No provider credential is created or rotated. The old spares4repairs/dev/applianceclinic-* secrets are unchanged.",
  "classification": "SAFE AC CHANGE",
  "stack": "AcDataStack",
  "kind": "UPDATE",
  "expectedChanges": [
    { "action": "Add", "logicalId": "AcAiConfig", "type": "AWS::SecretsManager::Secret", "physicalId": null, "replacement": null },
    { "action": "Add", "logicalId": "AcOpenAi", "type": "AWS::SecretsManager::Secret", "physicalId": null, "replacement": null },
    { "action": "Add", "logicalId": "AcJev", "type": "AWS::SecretsManager::Secret", "physicalId": null, "replacement": null }
  ],
  "grant": [
    { "Action": ["secretsmanager:CreateSecret", "secretsmanager:TagResource", "secretsmanager:DescribeSecret"],
      "Resource": ["arn:aws:secretsmanager:eu-west-1:800960611664:secret:applianceclinic/production/*"] },
    { "Action": ["secretsmanager:GetRandomPassword"], "Resource": ["*"] }
  ],
  "grantNotes": "Creation of secrets under applianceclinic/production/ only. No value read, no put, no delete, nothing under spares4repairs/.",
  "writes": {
    "types": ["AWS::SecretsManager::Secret"],
    "expected": ["secretsmanager:CreateSecret", "secretsmanager:TagResource"],
    "forbidden": ["secretsmanager:DeleteSecret", "secretsmanager:PutSecretValue", "secretsmanager:UpdateSecret", "secretsmanager:RestoreSecret"],
    "resources": ["applianceclinic/production/ai-config", "applianceclinic/production/openai", "applianceclinic/production/jev"],
    "forbiddenResources": ["spares4repairs/dev/", "spares4repairs/diag-orchestrator/", "spares4repairs/error-code-mcp/"]
  }
}
