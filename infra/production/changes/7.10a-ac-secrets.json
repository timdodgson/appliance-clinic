{
  "id": "7.10a-ac-secrets",
  "description": "Create the AC secret namespace in AcDataStack: applianceclinic/production/canonical-state-token ({current}), orchestrator-bearer and mcp-bearer ({token}). Secrets Manager generates every value at creation (GenerateSecretString); no value is in the template, git or any log. Nothing uses them yet, and no existing secret changes.",
  "classification": "SAFE AC CHANGE",
  "stack": "AcDataStack",
  "kind": "UPDATE",
  "expectedChanges": [
    { "action": "Add", "logicalId": "AcCanonicalStateToken", "type": "AWS::SecretsManager::Secret", "physicalId": null, "replacement": null },
    { "action": "Add", "logicalId": "AcOrchestratorBearer", "type": "AWS::SecretsManager::Secret", "physicalId": null, "replacement": null },
    { "action": "Add", "logicalId": "AcMcpBearer", "type": "AWS::SecretsManager::Secret", "physicalId": null, "replacement": null }
  ],
  "grant": [
    { "Action": ["secretsmanager:CreateSecret", "secretsmanager:TagResource", "secretsmanager:DescribeSecret"],
      "Resource": ["arn:aws:secretsmanager:eu-west-1:800960611664:secret:applianceclinic/production/*"] },
    { "Action": ["secretsmanager:GetRandomPassword"], "Resource": ["*"] }
  ],
  "grantNotes": "Creation of secrets under applianceclinic/production/ only, and the random generator CreateSecret uses (GetRandomPassword takes no resource). No value read, no put, no delete, nothing under spares4repairs/.",
  "writes": {
    "types": ["AWS::SecretsManager::Secret"],
    "expected": ["secretsmanager:CreateSecret", "secretsmanager:TagResource"],
    "forbidden": ["secretsmanager:DeleteSecret", "secretsmanager:PutSecretValue", "secretsmanager:UpdateSecret", "secretsmanager:RestoreSecret"],
    "resources": ["applianceclinic/production/canonical-state-token", "applianceclinic/production/orchestrator-bearer", "applianceclinic/production/mcp-bearer"],
    "forbiddenResources": ["spares4repairs/dev/", "spares4repairs/diag-orchestrator/", "spares4repairs/error-code-mcp/"]
  }
}
